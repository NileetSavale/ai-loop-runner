# Copy to backend/.env. Only a model key is needed to run Loop Runner locally; everything else has a working default.

# A key for at least one model provider (the model you pick for a session must match it)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# Local mode: no login. Keep the backend on localhost while this is on: an anonymous session can run commands.
ALLOW_ANONYMOUS=true

# Data stays on this machine. SQLite by default; any SQLAlchemy URL works, e.g. the queue profile's Postgres.
# DATABASE_URL=sqlite:///./loop_runner.db
# REDIS_URL=redis://localhost:6379

# Spending and safety limits
# MAX_SESSION_COST_USD=5
# MAX_VERIFY_TIMEOUT_SECONDS=120

# Only for a hosted, multi-user server (not needed locally):
# SUPABASE_JWT_SECRET=     login tokens from a Supabase project; then set ALLOW_ANONYMOUS=false
# ALLOWED_USER_IDS=        comma-separated user ids allowed in
# VAULT_KEY=               encrypts the API keys users save in the app
# LOOP_RUNNER_HOSTED=1     sessions only on GitHub repos, never local folders

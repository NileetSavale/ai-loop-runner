# Copy to frontend/.env.local. Everything is optional for local use.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Leave empty for local mode (no login). Set both, from a Supabase project, for a hosted multi-user site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
